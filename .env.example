NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Internal worker endpoint secrets. Generate independent 32+ character values.
OUTBOX_WORKER_SECRET=
COMPLIANCE_WORKER_SECRET=
FILE_RETENTION_WORKER_SECRET=
FILE_ACCESS_SIGNING_SECRET=
AUDIT_EVIDENCE_SECRET=
RATE_LIMIT_HASH_SECRET=
# Shared secret for /api/cron/* endpoints. Used by Hostinger cron jobs.
CRON_SECRET=

# OpenRouter AI chatbot (free tier available)
OPENROUTER_API_KEY=

# Optional: external malware scanner. If unset, uploads pass signature-gate checks only.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# Optional private S3-compatible personnel storage. When this complete group is
# unset, the application uses the private Supabase `personnel-files` bucket.
# These values are server-only and must never use NEXT_PUBLIC_ prefixes.
HOSTINGER_OBJECT_STORAGE_ENDPOINT=
HOSTINGER_OBJECT_STORAGE_REGION=
HOSTINGER_OBJECT_STORAGE_ACCESS_KEY=
HOSTINGER_OBJECT_STORAGE_SECRET_KEY=
HOSTINGER_OBJECT_STORAGE_BUCKET=
HOSTINGER_OBJECT_STORAGE_FORCE_PATH_STYLE=true
# AES256 (SSE-S3) or aws:kms. Set the key id when using aws:kms.
HOSTINGER_OBJECT_STORAGE_ENCRYPTION=AES256
HOSTINGER_OBJECT_STORAGE_KMS_KEY_ID=

# Preferred on Hostinger Web Apps: a private absolute directory outside
# public_html. When set, every application upload is written here.
HOSTINGER_FILE_STORAGE_ROOT=

# Database migrations. Prefer the Supabase pooler URL in CI/IPv4-only networks.
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres
# DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...
MIGRATION_ACTOR=local-developer
# Optional safety switch used by cleanup/backfill maintenance scripts. Keep enabled for the first rehearsal.
DRY_RUN=1

# Supabase Management API fallback and type-generation tooling.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Destructive/adoption switches are intentionally false by default.
ALLOW_DESTRUCTIVE_SCHEMA_APPLY=false
ALLOW_DESTRUCTIVE_MIGRATION=false
ALLOW_MIGRATION_ADOPTION=false

# Initial production administrator. Supply through a secret manager, never Git.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ORG_ID=
INITIAL_ORG_NAME=
INITIAL_ORG_SLUG=

# Optional named platform administrator seed.
DR_AMR_ADMIN_EMAIL=
DR_AMR_ADMIN_NAME=
DR_AMR_ADMIN_PASSWORD=
DR_AMR_ORG_ID=
DR_AMR_ORG_NAME=
DR_AMR_ORG_SLUG=

# Optional production/demo seed credentials. Never enable demo users in production.
PROD_SUPERADMIN_PASSWORD=
PROD_HR_PASSWORD=
PROD_RECRUITER_PASSWORD=
DEMO_HR_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=

# Optional local-only demo login autofill. Keep disabled in production.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_EMPLOYEE_EMAIL=
NEXT_PUBLIC_DEMO_EMPLOYEE_PASSWORD=

# Optional seed sizing/date overrides.
SEED_EMPLOYEE_COUNT=
SEED_SALES_COUNT=
SEED_SALES_HISTORY_FROM=
SEED_SALES_HISTORY_TO=
SEED_SALES_DAILY_AGENT_COUNT=
SEED_SALES_DAILY_BASELINE=
SEED_SALES_DAILY_MIN=
SEED_SALES_DAILY_MAX=
SEED_ATTENDANCE_DATES=
SEED_ATTENDANCE_PRESENT_COUNT=
SEED_ATTENDANCE_LATE_MINUTES=
SEED_ATTENDANCE_ABSENT_COUNT=
SEED_RECRUITMENT_JOBS=
SEED_RECRUITMENT_APPLICATIONS=
SEED_DEMO_MY_TASK_COUNT=
SEED_DEMO_ASSIGNMENT_TASK_COUNT=
SEED_DEMO_SCHEDULE_ASSIGNMENT_COUNT=
SEED_DEMO_LEAVE_REQUEST_COUNT=
